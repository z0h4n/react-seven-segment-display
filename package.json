{
  "name": "react-seven-segment-display",
  "version": "3.0.0",
  "description": "A Seven Segment Display Component for ReactJS",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsdown",
    "images": "npm run build && node scripts/generate-images.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z0h4n/react-seven-segment-display.git"
  },
  "keywords": [
    "react",
    "seven",
    "segment",
    "display",
    "component",
    "7",
    "7-segment",
    "seven-segment"
  ],
  "author": "z0h4n",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/z0h4n/react-seven-segment-display/issues"
  },
  "homepage": "https://github.com/z0h4n/react-seven-segment-display#readme",
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
